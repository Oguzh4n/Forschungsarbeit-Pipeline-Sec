# =============================================================================
# DEMO: Accidentally committed .env file
#
# This file simulates a developer accidentally committing a .env file that
# contains credentials. The values below are non-functional placeholders
# that match the structural format TruffleHog's detectors look for.
#
# Real incidents of this type include:
#   - Slack webhook URLs committed in configuration files
#   - GitHub Personal Access Tokens in CI scripts
#   - Stripe keys in environment files
#
# TruffleHog will detect these patterns in the PR diff and block the merge.
# =============================================================================

# Slack Incoming Webhook URL (non-functional demo value)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T01AB2CD3E/B01FG4HI5J/FaKeSlAcKwEbHoOkToKeNfOrDeM

# GitHub Personal Access Token (non-functional demo value)
GITHUB_TOKEN=ghp_FaKePeRsOnAlAcCeSsToKeNdEmO1234567

# Stripe Secret Key (non-functional demo value)
STRIPE_SECRET_KEY=sk_live_FaKeStRiPeLiVeSeCreTkEydEmO001
